# Copy this file to .env.local (development) or configure the same keys
# in your hosting provider's environment variables panel (production).
# Full explanations: GUIDE.md and GTA&SEO.md

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.anbadvisors.com
NEXT_PUBLIC_CONTACT_EMAIL=info@anbadvisors.com
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=+91 XXXXX XXXXX
NEXT_PUBLIC_CONTACT_PHONE_E164=+91XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# --- Social ---
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/anb-advisors
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/anbadvisors
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Analytics (leave as-is to keep tags disabled) ---
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# --- Optional integrations ---
# External booking calendar (Calendly/Cal.com) — leave blank to use the
# built-in Book Consultation modal + database instead.
NEXT_PUBLIC_CALENDLY_URL=

# Forward every form submission to a webhook (Slack/CRM/Zapier/n8n/etc.)
LEAD_WEBHOOK_URL=
